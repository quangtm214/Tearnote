{
  "expo": {
    "name": "Tearnote",
    "slug": "tearnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tearnote",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1614",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1614",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Tearnote uses the microphone so you can add a voice note to a cry. The recording stays on your phone.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tearnote opens your photo library so you can add photos to a cry. Photos stay on your phone.",
          "cameraPermission": "Tearnote uses the camera so you can take a photo for a cry. Photos stay on your phone."
        }
      ]
    ],
    "locales": {
      "vi": "./locales/vi.json",
      "ja": "./locales/ja.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
