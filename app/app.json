{
  "expo": {
    "name": "Tearnote",
    "slug": "tearnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tearnote",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1614",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1614",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Tearnote dùng micro để bạn ghi âm kèm một lần khóc. Đoạn ghi âm chỉ nằm trong máy.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tearnote mở thư viện ảnh để bạn chọn ảnh kèm một lần khóc. Ảnh chỉ nằm trong máy.",
          "cameraPermission": "Tearnote dùng camera để bạn chụp ảnh kèm một lần khóc. Ảnh chỉ nằm trong máy."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
