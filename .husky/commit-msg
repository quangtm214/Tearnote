#!/bin/sh
# Commit rules for this repo. See the commit section of CLAUDE.md.
#   1. A single title line, no body.
#   2. At most 100 characters.
#   3. English — enforced by rejecting non-ASCII characters (Vietnamese diacritics are non-ASCII).
#   4. No Co-Authored-By trailer.
#
# husky runs this file with `sh -e`, so every check must be an if/then:
# a one-line `grep ... && fail` would exit the script when grep does not match.

msg_file="$1"

fail() {
  echo "commit-msg bị từ chối: $1" >&2
  echo "  title: $title" >&2
  echo "  luat: mot dong, <= 100 ky tu, tieng Anh, khong Co-Authored-By" >&2
  exit 1
}

# Drop git's comment lines and trailing blank lines
body=$(grep -v '^#' "$msg_file" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}')
title=$(printf '%s\n' "$body" | head -1)
extra=$(printf '%s\n' "$body" | tail -n +2 | grep -c '[^[:space:]]' || true)
len=$(printf '%s' "$title" | wc -c)

if [ -z "$title" ]; then
  fail "message rong"
fi

if [ "$extra" -ne 0 ]; then
  fail "chi duoc co title, khong duoc them noi dung phia sau"
fi

if [ "$len" -gt 100 ]; then
  fail "title dai $len ky tu, toi da 100"
fi

if printf '%s' "$title" | LC_ALL=C grep -q '[^ -~]'; then
  fail "title phai bang tieng Anh (co ky tu ngoai ASCII)"
fi

if printf '%s\n' "$body" | grep -qi 'co-authored-by'; then
  fail "khong duoc co trailer Co-Authored-By"
fi

exit 0
